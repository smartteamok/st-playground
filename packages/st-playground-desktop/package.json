{
  "name": "@st-playground/desktop",
  "productName": "ST-Playground",
  "version": "0.4.0",
  "private": true,
  "description": "ST-Playground as a self-contained desktop application for school computers",
  "author": "ST-Playground",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/scratchfoundation/scratch-editor",
  "main": "./dist/main/main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "compile": "node scripts/compile.mjs",
    "compile:main": "webpack --config webpack.main.js",
    "compile:renderer": "webpack --config webpack.renderer.js",
    "dist": "node scripts/compile.mjs --check-assets && electron-builder",
    "dist:linux": "node scripts/compile.mjs --check-assets && electron-builder --linux AppImage",
    "dist:win": "node scripts/compile.mjs --check-assets && electron-builder --win nsis zip",
    "dist:dir": "node scripts/compile.mjs --check-assets && electron-builder --linux dir"
  },
  "dependencies": {
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.1.3",
    "redux": "4.2.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@scratch/scratch-gui": "15.1.1",
    "babel-loader": "9.2.1",
    "copy-webpack-plugin": "6.4.1",
    "css-loader": "5.2.7",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "html-webpack-plugin": "5.6.8",
    "style-loader": "4.0.0",
    "webpack": "5.109.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.6"
  }
}
